{
  "name": "plinthio",
  "version": "1.0.0",
  "description": "All-in-one self-hosted media server & PWA for Audiobooks, Manga & Comics, Books, Movies, TV Shows, and Anime",
  "private": true,
  "scripts": {
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "build:frontend": "cd frontend && npm run build",
    "start": "cd backend && npm start",
    "docker:build": "docker build -t plinthio:latest -f docker/Dockerfile .",
    "docker:up": "docker compose -f docker/docker-compose.yml up -d",
    "release:version": "node scripts/set-version.mjs",
    "test": "cd backend && npm test"
  },
  "keywords": [
    "audiobooks",
    "manga",
    "comics",
    "ebooks",
    "self-hosted",
    "pwa",
    "media-server",
    "docker"
  ],
  "author": "Odd Omens LLC",
  "license": "SEE LICENSE IN LICENSE"
}
